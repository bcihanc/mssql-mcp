{
  "name": "@bcihanc/mssql-mcp",
  "version": "1.0.1",
  "type": "module",
  "description": "Microsoft SQL Server MCP (Model Context Protocol) server with SQL query execution and Windows Authentication support",
  "author": "Cihan",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mssql-mcp": "./dist/main.mjs"
  },
  "main": "./dist/main.mjs",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "mssql",
    "sql-server",
    "model-context-protocol",
    "claude",
    "anthropic",
    "database",
    "ai-tools"
  ],
  "devDependencies": {
    "@hono/mcp": "^0.1.4",
    "@hono/node-server": "^1.19.3",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.0.0",
    "commander": "^12.1.0",
    "consola": "^3.2.3",
    "dotenv": "^16.4.5",
    "esbuild": "^0.25.0",
    "hono": "^4.9.9",
    "mssql": "^12.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "zod": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --loader ts-node/esm src/scripts/bundle.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "dev": "node --loader ts-node/esm src/main.ts",
    "test:security": "node --loader ts-node/esm src/tests/security.test.ts"
  }
}
